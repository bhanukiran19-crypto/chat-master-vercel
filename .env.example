# ---- Postgres (docker-compose) -------------------------------------------
POSTGRES_DB=chatmaster
POSTGRES_PORT=5432
# Owner / migration role. Used ONLY by `prisma migrate`.
POSTGRES_USER=chatmaster_migrator
POSTGRES_PASSWORD=change-me-migrator
# Least-privilege runtime role used by apps/api and apps/worker (RLS enforced).
APP_DB_USER=chatmaster_api
APP_DB_PASSWORD=change-me-api

# Connection strings derived from the above.
DATABASE_URL=postgresql://chatmaster_migrator:change-me-migrator@localhost:5432/chatmaster?schema=public
APP_DATABASE_URL=postgresql://chatmaster_api:change-me-api@localhost:5432/chatmaster?schema=public

# ---- Redis ----------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@localhost:6379

# ---- Encryption (AES-256-GCM, versioned) ----------------------------------
# Comma-separated list of <version>:<base64 32-byte key>. Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=1:REPLACE_WITH_BASE64_32_BYTE_KEY
# Version used for new ciphertexts. Older versions stay decryptable for rotation.
ENCRYPTION_ACTIVE_KEY_VERSION=1
