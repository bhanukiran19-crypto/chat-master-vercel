{
  "name": "chatmaster",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "db:generate": "pnpm --filter @chatmaster/db run generate",
    "db:migrate": "pnpm --filter @chatmaster/db run migrate:deploy",
    "db:migrate:dev": "pnpm --filter @chatmaster/db run migrate:dev",
    "db:validate": "pnpm --filter @chatmaster/db run validate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "tinypool@<2.1.2": ">=2.1.2",
      "vite@<6.4.4": "^6.4.4"
    }
  }
}
